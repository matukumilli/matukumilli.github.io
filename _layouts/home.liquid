<style>
  /* --- Homepage layout inspired by mikepols.github.io --- */

  .home-wrapper {
    max-width: 740px;
    margin: 0 auto;
    padding: 60px 20px;
    text-align: center;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .home-title {
    font-size: 3rem;
    font-weight: 700;
