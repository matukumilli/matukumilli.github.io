  author={Prasad, Matukumilli V. D. and Waghmare, Umesh V.},
  editor={Mele, Paolo and Narducci, Dario and Ohta, Michihiro and Biswas, Kaniskha and Morante, Juan and Saini, Shrikant and Endo, Tamio},
  title={Theory and Simulations of Lattice Thermal Conduction},
  booktitle={Thermoelectric Thin Films: Materials and Devices},
  year={2019},
  publisher={Springer International Publishing},
  address={Cham},
  pages={43--67},
  abstract={The linearized Boltzmann--Peierls phonon transport equation (BTE) is recently gaining popularity as a framework for describing phonon transport in solids. Here we present the developments in the simulation of lattice thermal conduction within the linearized BTE, along with the assumptions involved. The second- and third-order interatomic force constants required in this analysis can be obtained from ab initio lattice dynamics calculations. We emphasize the shortcomings of single mode relaxation time approximation (RTA) over the full solution of BTE, which can be realized in a self-consistent fashion through an iterative approach. In the rest of this chapter, we illustrate key benefits of this approach through application to lattice dynamics and phonon transport in several materials.},
